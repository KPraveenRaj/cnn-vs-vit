# Local notes & drafts — not part of the public artifact.
# The document GENERATORS are code and stay public (they are the proof that no
# number in a deck or report is typed by hand); only their .pptx/.docx output,
# weekly notes and drafts stay local. Note the four-line dance: git cannot
# re-include a file whose parent directory is excluded, so the directory has to
# be un-excluded before its contents can be filtered.
/report/*
!/report/build/
/report/build/*
!/report/build/*.py

# Learning workspace & scratch notebooks stay local (project deliverable notebooks are tracked)
/learning/
notebooks/phase0*
notebooks/scratch/

# Data & heavy artifacts — never committed
data/raw/*
!data/raw/.gitkeep
results/checkpoints/*
!results/checkpoints/.gitkeep
# Archived superseded runs: keep their metadata (configs, logs, metrics) but
# never their weights — an archive directory is outside the results/checkpoints
# rule above, and `git add -A` will happily try to stage 300 MB .pt files.
results/archive/**/checkpoints/
*.pt
results/features/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Run logs: per-epoch console spam. The structured record lives in
# results/runs/<run_id>/train_log.csv, which IS committed.
/logs/

# Cached backbone features for linear probes (regenerable, hundreds of MB)
results/features/
